# Copy to .env and fill in your keys
export FRED_API_KEY=
export OPENAI_API_KEY=
export OPENAI_BASE_URL=   # Optional: use OpenAI-compatible APIs (e.g. Azure, local LLM)
export SENTIMENT_ROBOT_LLM_MODEL=   # Required when OPENAI_BASE_URL is set (e.g. qwen2.5:7b, gpt-4o-mini)
export FEISHU_WEBHOOK_URL=
export SENTIMENT_ROBOT_LLM_ENABLED=true

# LLM stock-relevance filter (default: true)
# When enabled, the LLM filters out news items unrelated to stocks/financial markets
# before they reach the Feishu card and sentiment report.
export SENTIMENT_ROBOT_LLM_FILTER_ENABLED=true
